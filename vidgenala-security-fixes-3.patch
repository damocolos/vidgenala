-      "beat_01": "def beat_01(v):\n    # Living-room couch split in two halves (art lives in lower half)\n    shake = v.wave(freq=7.0, amp=2.5)\n    v.backdrop_circle(r=300, color=\"yellow_stage\", x=0, y=150)\n    # couch backrest + seat, split down the middle\n    v.rect(-150, 125, 300, 90, radius=26, color=\"brown\", delay=0.0)\n    v.rect(150, 125, 300, 90, radius=26, color=\"brown\", delay=0.05)\n    v.rect(0, 205, 640, 70, radius=24, color=\"stone_dark\", delay=0.1)\n    v.line(0, 90, 0, 240, width=8, color=\"cream\")\n\n    # --- Dad (left): crossed arms, flat mouth\n    dx = -170\n    v.rect(dx, 165, 120, 110, radius=40, color=\"blue_soft\", delay=0.15)\n    v.circle(dx, 70, 46, color=\"skin\", delay=0.15)\n    v.rect(dx, 150, 130, 28, radius=14, color=\"skin_dark\", delay=0.25)\n    v.line(dx - 20, 55, dx - 8, 60, width=5, color=\"dark\")\n    v.line(dx + 20, 55, dx + 8, 60, width=5, color=\"dark\")\n    v.line(dx - 16, 88, dx + 16, 88, width=5, color=\"dark\")\n    # storm cloud rumbling quietly + muted bolt\n    v.blob(dx + shake, -20, r=42, lobes=6, color=\"stone_dark\", delay=0.3)\n    v.poly([(dx - 4, 5), (dx + 12, 5), (dx + 2, 25), (dx + 14, 25),\n            (dx - 8, 55), (dx - 2, 32), (dx - 14, 32)],\n           color=\"grey\", dx=shake, alpha=int(150 + 80 * abs(math.sin(v.lt * 3))), delay=0.35)\n\n    # --- Mom (right): tissue, falling tears\n    mx = 50\n    v.circle(mx, 62, 54, color=\"brown\", delay=0.2)\n    v.rect(mx, 165, 115, 110, radius=40, color=\"pink_soft\", delay=0.2)\n    v.circle(mx, 72, 44, color=\"skin\", delay=0.2)\n    v.circle(mx + 14, 66, 5, color=\"dark\")\n    v.arc(mx + 10, 92, 22, 12, start=180, end=360, width=4, color=\"dark\")\n    v.rect(mx - 30 + v.wave(freq=2.0, amp=3), 112, 34, 30, radius=8, color=\"white\", angle=-12, delay=0.3)\n    for i in range(3):\n        t = (v.lt * 1.1 + i / 3.0) % 1.0\n        ty = 82 + t * 95\n        if t < 0.85:\n            v.droplet(mx + 24, ty, r=11, color=\"blue_tear\")\n        else:\n            sq = (t - 0.85) / 0.15\n            v.ellipse(mx + 24, 178, 26 + 14 * sq, 10, color=\"blue_tear\", alpha=int(255 * (1 - sq)))\n\n    # --- Retro TV with heart + film reel\n    tx, ty0 = 265, 120\n    v.line(tx - 20, ty0 - 70, tx - 45, ty0 - 110, width=5, color=\"dark\")\n    v.line(tx + 20, ty0 - 70, tx + 45, ty0 - 110, width=5, color=\"dark\")\n    v.rect(tx, ty0, 160, 130, radius=22, color=\"stone_dark\", delay=0.25)\n    v.rect(tx - 10, ty0, 115, 95, radius=14, color=\"blue_soft\", delay=0.3)\n    s = 16 * v.pulse(freq=1.8, lo=0.9, hi=1.1)\n    v.circle(tx - 18 - s * 0.5, ty0 - 8 - s * 0.3, s * 0.6, color=\"pink_organ\")\n    v.circle(tx - 18 + s * 0.5, ty0 - 8 - s * 0.3, s * 0.6, color=\"pink_organ\")\n    v.poly([(tx - 18 - s * 1.08, ty0 - 6), (tx - 18 + s * 1.08, ty0 - 6), (tx - 18, ty0 + s * 1.2)], color=\"pink_organ\")\n    v.circle(tx + 25, ty0 + 22, 13, color=\"dark\")\n    v.circle(tx + 25, ty0 + 22, 4, color=\"white\")\n    v.circle(tx + 66, ty0 - 20, 7, color=\"grey\")",
-      "beat_02": "def beat_02(v):\n    def gear(x, y, r, ang, c):\n        pts = []\n        n = 8\n        for k in range(n):\n            a0 = ang + k * 360.0 / n\n            for off, rr in ((-16, r * 0.76), (-9, r), (9, r), (16, r * 0.76)):\n                a = math.radians(a0 + off)\n                pts.append((x + rr * math.cos(a), y + rr * math.sin(a)))\n        v.poly(pts, color=c)\n        v.circle(x, y, r * 0.32, color=\"blue_soft\")\n\n    beat = v.pulse(freq=1.6, lo=0.9, hi=1.12)\n    tick = int(v.lt * 3.2) * 22.5 + 22.5 * v.ease(delay=(v.lt * 3.2 % 1) / 3.2 * 0, dur=0.1)\n\n    # --- Left head (blue, faces left)\n    lx, ly = -175, -120\n    v.circle(lx, ly, 115, color=\"blue_soft\", delay=0.0)\n    v.poly([(lx - 100, ly + 10), (lx - 140, ly + 45), (lx - 95, ly + 60)], color=\"blue_soft\", delay=0.0)\n    v.rect(lx + 10, ly + 110, 120, 70, radius=24, color=\"blue_soft\", delay=0.0)\n    gear(lx - 30, ly - 35, 42, tick, \"stone\")\n    gear(lx + 38, ly + 10, 30, -tick + 10, \"grey\")\n    v.rect(lx - 10, ly + 65, 110, 40, radius=10, color=\"dark\", delay=0.2)\n    v.label_pill(lx - 10, ly + 65, text=\"1+1=2\", bg=\"dark\", fg=\"mint_soft\", size=22, pointer=False, delay=0.25)\n\n    # --- Right head (pink, faces right)\n    rx, ry = 175, -120\n    v.circle(rx, ry, 115, color=\"pink_soft\", delay=0.1)\n    v.poly([(rx + 100, ry + 10), (rx + 140, ry + 45), (rx + 95, ry + 60)], color=\"pink_soft\", delay=0.1)\n    v.rect(rx - 10, ry + 110, 120, 70, radius=24, color=\"pink_soft\", delay=0.1)\n    s = 38 * beat\n    hx, hy = rx - 10, ry\n    v.circle(hx - s * 0.5, hy - s * 0.3, s * 0.6, color=\"red_hot\")\n    v.circle(hx + s * 0.5, hy - s * 0.3, s * 0.6, color=\"red_hot\")\n    v.poly([(hx - s * 1.08, hy - 6), (hx + s * 1.08, hy - 6), (hx, hy + s * 1.2)], color=\"red_hot\")\n    v.droplet(rx + 55, ry - 55 + v.wave(freq=1.5, amp=8), r=14, color=\"blue_tear\", delay=0.3)\n    v.starburst(rx - 60, ry - 65 + v.wave(freq=1.8, amp=6, phase=1.0), r_out=18, r_in=7, points=4, color=\"yellow_stage\", speed=0.8, delay=0.35)\n\n    # --- Swinging dashed tags\n    sw1 = 14 * math.sin(v.lt * 5) * math.exp(-v.lt * 1.2)\n    sw2 = 14 * math.sin(v.lt * 5 + 1.2) * math.exp(-v.lt * 1.2)\n    v.line(lx, ly - 115, lx + sw1, ly - 160, width=4, color=\"dark\", dashed=True)\n    v.label_pill(lx + sw1, ly - 160, text=\"LOGIS\", bg=\"white\", fg=\"blue_tear\", size=30, pointer=False, delay=0.5)\n    v.line(rx, ry - 115, rx + sw2, ry - 160, width=4, color=\"dark\", dashed=True)\n    v.label_pill(rx + sw2, ry - 160, text=\"EMOSIONAL\", bg=\"white\", fg=\"red_hot\", size=30, pointer=False, delay=0.7)",
-      "beat_03": "def beat_03(v):\n    by = 185\n    paused = v.lt > 1.3\n    sep = 4 + 20 * v.ease(delay=0.6, dur=0.6)\n    wob = 0 if paused else v.wave(freq=6.0, amp=4.0)\n    L = -58 - sep - wob\n    R = 58 + sep + wob\n\n    v.ellipse(0, by + 78, 300, 22, color=\"dark\", alpha=40)\n    v.blob(L, by, r=72, lobes=6, color=\"pink_soft\", delay=0.0)\n    v.blob(R, by, r=72, lobes=6, color=\"pink_soft\", delay=0.05)\n    # grey creases\n    v.bezier([(L - 45, by - 20), (L - 20, by - 40), (L, by), (L + 25, by - 25)], width=6, color=\"grey\")\n    v.bezier([(L - 40, by + 25), (L - 15, by + 10), (L + 5, by + 40), (L + 30, by + 20)], width=6, color=\"grey\")\n    v.bezier([(R - 25, by - 25), (R, by), (R + 20, by - 40), (R + 45, by - 20)], width=6, color=\"grey\")\n    v.bezier([(R - 30, by + 20), (R - 5, by + 40), (R + 15, by + 10), (R + 40, by + 25)], width=6, color=\"grey\")\n\n    # jagged crack zipping down\n    pts = [(0, by - 75), (-10, by - 50), (8, by - 25), (-8, by), (10, by + 25), (-6, by + 50), (0, by + 72)]\n    prog = v.ease(delay=0.15, dur=0.45)\n    segs = len(pts) - 1\n    for i in range(segs):\n        sp = min(1.0, max(0.0, prog * segs - i))\n        if sp > 0:\n            v.line(pts[i][0], pts[i][1], pts[i + 1][0], pts[i + 1][1], width=6, color=\"dark\", progress=sp)\n\n    # giant bouncing question mark\n    s = v.elastic(delay=1.1, dur=0.7)\n    if s > 0.01:\n        qy = 60 + v.wave(freq=2.2, amp=7) - 20 * s\n        k = 0.9 * s\n        v.circle(0, qy, 62 * k, color=\"yellow_stage\", alpha=200)\n        v.bezier([(-26 * k, qy - 28 * k), (-26 * k, qy - 70 * k), (34 * k, qy - 70 * k), (28 * k, qy - 28 * k)], width=int(16 * k) + 1, color=\"purple\")\n        v.bezier([(28 * k, qy - 28 * k), (22 * k, qy - 5 * k), (0, qy - 8 * k), (0, qy + 18 * k)], width=int(16 * k) + 1, color=\"purple\")\n        v.circle(0, qy + 42 * k, 10 * k, color=\"purple\")",
-      "beat_04": "def beat_04(v):\n    def gear(x, y, r, c):\n        ang = v.lt * 60\n        pts = []\n        for k in range(8):\n            a0 = ang + k * 45\n            for off, rr in ((-16, r * 0.76), (-9, r), (9, r), (16, r * 0.76)):\n                a = math.radians(a0 + off)\n                pts.append((x + rr * math.cos(a), y + rr * math.sin(a)))\n        v.poly(pts, color=c)\n        v.circle(x, y, r * 0.33, color=\"white\")\n\n    cy = 40\n    v.rect(0, cy, 640, 290, radius=18, color=\"dark\", delay=0.0)\n    v.rect(-158, cy, 296, 260, radius=10, color=\"blue_soft\", delay=0.05)\n    v.rect(158, cy, 296, 260, radius=10, color=\"pink_soft\", delay=0.1)\n    merge = v.ease(delay=1.9, dur=0.6)\n    if merge > 0:\n        v.rect(0, cy, 612, 260, radius=10, color=\"mint_soft\", alpha=int(255 * merge))\n\n    # wall of bricks crumbling + door\n    for i in range(8):\n        bx = 0\n        byy = cy - 115 + i * 33\n        f = v.ease(delay=0.9 + i * 0.1, dur=0.5)\n        if f < 1.0:\n            v.rect(bx + (i % 2 * 2 - 1) * 30 * f, byy + 200 * f * f, 20, 30, radius=4,\n                   color=\"stone_dark\", angle=60 * f * (1 if i % 2 else -1), alpha=int(255 * (1 - f)))\n    door = v.ease(delay=0.8, dur=0.5)\n    if door < 1.0:\n        v.rect(0, cy + 260 * door, 26, 64, radius=6, color=\"brown\", alpha=int(255 * (1 - door)))\n        v.circle(6, cy + 260 * door, 3, color=\"yellow_stage\")\n\n    drift = 75 * v.spring(delay=2.1, dur=0.7)\n    gx = -158 + drift\n    fx = 158 - drift\n    bob = v.wave(freq=1.5, amp=5)\n    gear(gx, cy - 15 + bob, 46, \"blue_tear\")\n    v.poly([(fx, cy - 75), (fx + 38, cy - 5), (fx + 25, cy + 30), (fx - 25, cy + 30), (fx - 38, cy - 5)],\n           color=\"red_hot\", dy=-bob, delay=0.15)\n    v.poly([(fx, cy - 30), (fx + 18, cy + 5), (fx + 10, cy + 25), (fx - 10, cy + 25), (fx - 18, cy + 5)],\n           color=\"yellow_stage\", dy=-bob, scale=v.pulse(freq=3, lo=0.9, hi=1.1), delay=0.2)\n    v.label_pill(gx, cy + 75, text=\"LOGIKA\", bg=\"white\", fg=\"blue_tear\", size=28, pointer=False, delay=0.3)\n    v.label_pill(fx, cy + 75, text=\"EMOSI\", bg=\"white\", fg=\"red_hot\", size=28, pointer=False, delay=0.4)",
-      "beat_05": "def beat_05(v):\n    hx, hy = -175, 165\n    v.rect(hx, hy, 210, 180, radius=12, color=\"white\", delay=0.0)\n    v.poly([(hx - 125, hy - 85), (hx, hy - 175), (hx + 125, hy - 85)], color=\"red_hot\", delay=0.05)\n    v.line(hx - 105, hy, hx + 105, hy, width=6, color=\"stone\")\n    v.rect(hx - 50, hy - 45, 44, 38, radius=6, color=\"blue_soft\", delay=0.1)\n    v.rect(hx + 50, hy - 45, 44, 38, radius=6, color=\"blue_soft\", delay=0.1)\n    v.rect(hx - 50, hy + 45, 40, 70, radius=8, color=\"brown\", delay=0.12)\n    v.rect(hx + 50, hy + 40, 44, 38, radius=6, color=\"blue_soft\", delay=0.12)\n    # price tag dangling from roof\n    tw = v.wave(freq=2.5, amp=6)\n    v.line(hx + 60, hy - 120, hx + 95 + tw, hy - 70, width=3, color=\"dark\")\n    v.label_pill(hx + 105 + tw, hy - 60, text=\"Rp 1 M\", bg=\"yellow_stage\", fg=\"dark\", size=24, pointer=False, delay=0.15)\n    # swinging DIJUAL sign\n    sw = v.wave(freq=1.8, amp=8)\n    v.line(hx - 150, hy + 90, hx - 150, hy - 10, width=8, color=\"brown\")\n    v.label_pill(hx - 150 + sw, hy + 15, text=\"DIJUAL\", bg=\"white\", fg=\"red_hot\", size=24, pointer=False, delay=0.2)\n\n    # contract sheet\n    cx, cy = 165, 160\n    v.rect(cx, cy, 180, 220, radius=10, color=\"white\", shadow=True, delay=0.1)\n    for i in range(4):\n        v.line(cx - 65, cy - 75 + i * 26, cx + 65 - (i % 2) * 30, cy - 75 + i * 26, width=6, color=\"grey\")\n    v.line(cx - 60, cy + 70, cx + 60, cy + 70, width=4, color=\"dark\", dashed=True, dash_speed=0)\n    # hand + trembling pen\n    tr = v.wave(freq=11.0, amp=3.5)\n    px, py = cx + 20 + tr, cy + 30 + v.wave(freq=9.0, amp=2.5, phase=0.7)\n    v.line(px, py, px + 55, py - 70, width=10, color=\"dark\")\n    v.ellipse(px + 55, py - 65, 58, 42, color=\"skin\", angle=-30, delay=0.15)\n    # floating calendar + coins\n    fy = v.wave(freq=1.4, amp=7)\n    v.rect(cx + 140, cy - 60 + fy, 60, 56, radius=8, color=\"white\", delay=0.25)\n    v.rect(cx + 140, cy - 82 + fy, 60, 14, radius=6, color=\"red_hot\", delay=0.25)\n    v.circle(cx + 130, cy + 40 - fy, 16, color=\"yellow_stage\", delay=0.3)\n    v.circle(cx + 158, cy + 62 - fy, 13, color=\"yellow_stage\", delay=0.35)",
