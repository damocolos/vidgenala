# Copy to .env (never commit .env). Used by docker-compose; for a plain `python run_server.py`
# export the same names in your shell.

# --- Server -------------------------------------------------------------------------------
# 127.0.0.1 = this computer only (no token needed). Anything else needs the token below.
NALARKA_HOST=127.0.0.1
NALARKA_PORT=8000
# Required when the server is reachable from other devices or runs in Docker.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
NALARKA_API_TOKEN=
# Host names people type in the browser, comma separated (others are rejected).
NALARKA_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins if you serve it from another address, e.g. https://studio.example.com
NALARKA_ALLOWED_ORIGINS=

# --- Data ---------------------------------------------------------------------------------
NALARKA_DATA_DIR=data
# Extra folders (separated by ; on Windows, : elsewhere) the app may read voiceovers/references from.
NALARKA_MEDIA_DIRS=

# --- AI provider keys (optional: you can also save them in Settings, where they are stored encrypted) --
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
